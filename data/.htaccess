# Impede o acesso web aos ficheiros da base de dados SQLite.
# A app acede ao ficheiro internamente via PHP; ninguém o pode descarregar.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
